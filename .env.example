# ==========================================
# Naina Voice AI & Hotel PMS Configuration
# ==========================================

# 1. Database (PostgreSQL)
# Local Docker or Cloud (Neon, Supabase, Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naina_pms

# 2. Google Gemini API (Agent Brain & Tool Calling)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. Cartesia API (Powers BOTH Ink-2 STT & Sonic TTS)
# Get from: https://play.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# 4. LiveKit Cloud (Real-time WebRTC Audio Transport)
# Get from: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# 5. Voice Server Port
PORT=4000
